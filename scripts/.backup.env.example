# ── Horae DB backup config ───────────────────────────────────────────────────
# Copy this file to ".backup.env" (same folder) and fill in the real values.
# .backup.env is gitignored — it holds your DB password, so it must NEVER be committed.

# Full Postgres connection string. Get the exact value from:
#   Supabase Dashboard → Project Settings → Database → Connection string → URI
# Use the "Session pooler" URI (works over IPv4). Replace [YOUR-PASSWORD] with your
# database password. If the password contains special characters (@ : / ? # etc.),
# percent-encode them (e.g. @ → %40).
#
# It looks like one of these:
#   postgresql://postgres.vexqmdrldxhwrpcwbxow:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
#   postgresql://postgres:[YOUR-PASSWORD]@db.vexqmdrldxhwrpcwbxow.supabase.co:5432/postgres
SUPABASE_DB_URL=

# Where to write the .zip archives. Point this at a CLOUD-SYNCED folder
# (OneDrive / Google Drive) so backups leave this machine automatically.
# Default if left blank: %USERPROFILE%\HoraeBackups
BACKUP_DIR=

# Delete archives older than this many days. Default: 30
RETENTION_DAYS=30
